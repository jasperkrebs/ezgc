; EasyGCode — coat hanger (vase mode) generator
; shape=ellipse tolerance=0.05mm seam=left
; layerHeight=0.8 lineWidth=2.4 totalHeight=2.4 direction=CCW
; printFeed=2400 travelFeed=6000 (mm/min)
; printer=pellet multiplier=1 (E in mm^3, volumetric)
; --- start G-code (pellet / Klipper) ---
SET_PRESSURE_ADVANCE EXTRUDER=extruder SMOOTH_TIME=0.04
SET_PRESSURE_ADVANCE EXTRUDER=extruder ADVANCE=0.0
_GINGER_BUZZER_TONE_INITIAL
_GINGER_BED_HEATING BED_TEMPERATURE=60
_GINGER_EXTRUDER_SET_UP S=200
_GINGER_EXTRUDER_SET_MID S=220
_GINGER_EXTRUDER_SET_DOWN S=230
G28 ; home
BED_MESH_PROFILE LOAD=global
_GINGER_PURGE_PARKING PURGE_LAYER_HEIGHT=2 PURGE_PARKING_SPEED=10000
_GINGER_EXTRUDER_WAIT_UP S=200
_GINGER_EXTRUDER_WAIT_MID S=220
_GINGER_EXTRUDER_WAIT_DOWN S=230
_GINGER_BED_WAIT BED_TEMPERATURE_MIN=50 BED_TEMPERATURE_MAX=100
_GINGER_EXTRUDER_MIXING_MULTIPLIER S=1
SET_EXTRUDER_ROTATION_DISTANCE EXTRUDER=extruder DISTANCE=456
SET_EXTRUDER_ROTATION_DISTANCE EXTRUDER=mixing_stepper DISTANCE=8000
_GINGER_PURGE PURGE_LENGHT=400 PURGE_SPEED=500 PURGE_MATERIAL_QUANTITY=3000
G90 ; absolute coordinates
G92 E0
M83 ; relative extrusion
M220 S100 ; reset speed factor
M221 S100 ; reset extrude factor
SET_PRESSURE_ADVANCE EXTRUDER=extruder ADVANCE=0
SET_PRESSURE_ADVANCE EXTRUDER=extruder SMOOTH_TIME=0.5
M106 S0 ; fan off for the ramp loop
_GINGER_BUZZER_TONE_INITIAL
; --- end of start G-code ---
G90 ; absolute positioning
M83 ; relative extrusion
; --- vase spiral ---
